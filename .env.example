FIREWORKS_API_KEY=

# Optional server runtime data directory. Vercel uses /tmp automatically when
# this is not set; attach a real DB/object store for multi-user production.
SHERPA_DATA_DIR=

# Optional LinkedIn proxy provider. Configure once; fresh LinkedIn cookies pin a
# stable sticky session id. Keeping the same IP is what keeps cookies usable.
LINKEDIN_PROXY_HOST=geo.iproyal.com
LINKEDIN_PROXY_PORT=12321
LINKEDIN_PROXY_USERNAME=

# Use {sessionId}, {stickyId}, or {accountId} where your provider expects a
# sticky-session token. For IPRoyal, that is commonly in the password string.
LINKEDIN_PROXY_PASSWORD=your_password_country-in_city-mumbai_session-{sessionId}_lifetime-30m
# Keep this false for LinkedIn. Rotating IPs can make fresh cookies look stale.
LINKEDIN_PROXY_ROTATE_ON_TUNNEL_FAIL=false
# Set false if you want reconnecting to reuse the old sticky proxy session id.
LINKEDIN_PROXY_RESET_ON_CONNECT=true

# Align the browser fingerprint and active-hours gate with the account/proxy geo.
# For an IPRoyal India/Mumbai proxy, use these values.
LINKEDIN_ACCOUNT_COUNTRY=IN
LINKEDIN_ACCOUNT_TIMEZONE=Asia/Kolkata
LINKEDIN_ACCOUNT_LOCALE=en-IN

# Keep heartbeats low-frequency. They only open a lightweight feed validation
# after the account has been quiet for this interval.
LINKEDIN_HEARTBEAT_ENABLED=true
LINKEDIN_HEARTBEAT_INTERVAL_MINUTES=180

# Optional professional LinkedIn bridge. When enabled, queued LinkedIn DMs use
# Unipile account_id/provider_id APIs instead of browser-cookie automation.
# Get DSN from the Unipile dashboard, create an API key, connect LinkedIn, then
# copy the connected account_id.
UNIPILE_ENABLED=false
UNIPILE_DSN=https://api49.unipile.com:17972
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
